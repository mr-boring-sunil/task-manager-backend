{
  "name": "raspberry-pi-task-manager-backend",
  "version": "1.0.0",
  "description": "Unified 3-Engine Backend for Raspberry Pi Task Manager",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "keywords": [
    "raspberry-pi",
    "task-manager",
    "express",
    "scheduling-engine",
    "database-security-engine",
    "communication-execution-engine",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "swagger-ui-express": "^5.0.1",
    "systeminformation": "^5.22.8",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "engines/**/*.js",
      "config/**/*.js",
      "shared/**/*.js",
      "app.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

# ========================================================
# Raspberry Pi Task Manager — Unified Backend Configuration
# ========================================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Real-Time SSE Stream Configuration (in milliseconds)
STREAM_DEFAULT_INTERVAL_MS=1000
STREAM_MIN_INTERVAL_MS=200
STREAM_HEARTBEAT_INTERVAL_MS=15000

# CORS Configuration
# Comma-separated list of allowed origins or * for all
CORS_ORIGIN=*

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MUTATION_MAX_REQUESTS=30

# Database Configuration (SQLite)
DATABASE_FILE=./data/task_manager.db
DATABASE_WAL_MODE=true

# Initial Administrative User Bootstrapping
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_EMAIL=admin@raspberrypi.local

# Security & Process Execution Allowlist
# Comma-separated list of permitted binaries/commands (without arguments)
ALLOWED_EXECUTABLES=node,python3,python,bash,sh,ls,ping,top,uptime,cat,echo,sleep,raspistill,vcgencmd

# Allowed working directories (comma-separated). Leave empty or specify permitted paths
ALLOWED_WORKING_DIRS=/home/pi,/tmp,/opt/task-manager

# Logging Configuration
# Levels: debug, info, warn, error
LOG_LEVEL=info
LOG_INTERACTIONS=true

# Security Mode & API Key
# If true, development fallback credentials can be used when x-api-key or tokens are omitted
SECURITY_DEV_MODE=true
API_KEY=dev-task-manager-key-change-in-production
JWT_SECRET=super_secret_jwt_key_replace_in_production_environment_123456
JWT_EXPIRATION_HOURS=24
